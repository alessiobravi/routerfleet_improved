# RouterFleet Improved - settings for docker compose.
#
# Copy this file to .env next to the compose file and set at least
# SERVER_ADDRESS and POSTGRES_PASSWORD. A line starting with # is not used:
# remove the # to change that setting. After a change: docker compose up -d
#
# Every setting is described in docs/installation.md (Configuration reference).

# ---------------------------------------------------------------------------
# Address and ports
# ---------------------------------------------------------------------------

# The name or IP address users type in the browser, without https:// and
# without a port. A wrong value gives "400 Bad Request" or "CSRF verification
# failed". localhost and 127.0.0.1 are always answered as well.
# Passkeys need a name with a certificate browsers trust, not an IP address.
SERVER_ADDRESS=my_server_address

# The ports RouterFleet answers on, on this host (default 80 and 443).
# Change them when those are taken - by another web server, for example - and
# open https://<SERVER_ADDRESS>:<HTTPS_PORT>. HTTP requests are redirected to
# HTTPS_PORT. Let's Encrypt still needs port 80 from the internet: forward it
# to HTTP_PORT on your router or firewall. Behind a reverse proxy, the proxy
# connects to HTTP_PORT.
#HTTP_PORT=80
#HTTPS_PORT=443

# The application's port on this host's loopback (127.0.0.1 only, never the
# network), for the monitoring container on the host's network. Change it if
# 8001 is taken on the host.
#MONITORING_PORT=8001

# Dual stack (IPv4 and IPv6) on RouterFleet's own network. Only on a host whose
# kernel has IPv6 switched off: IPV6=false keeps the containers on IPv4.
#IPV6=true

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------

# always: HTTP redirects to HTTPS, cookies are marked Secure (recommended).
# never:  the application is served on plain HTTP as well - passwords then
#         cross the network in cleartext. Use with caution.
# Applies while System settings -> HTTPS is "As configured in .env" (the
# default); a certificate chosen there takes over.
HTTPS_REDIRECT_POLICY=always

# Emergency only: if a setting in System settings -> HTTPS locks you out,
# env (back to HTTPS_REDIRECT_POLICY) or selfsigned overrides it until removed.
#HTTPS_MODE_OVERRIDE=

# 1: use Let's Encrypt's test service, to try a setup without its rate limits.
#LETSENCRYPT_STAGING=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# postgres (the bundled database, docker-compose.yml) or sqlite. SQLite and an
# external PostgreSQL server use docker-compose-no-postgres.yml.
DATABASE_ENGINE=postgres

# Database name.
POSTGRES_DB=routerfleet

# Database user.
POSTGRES_USER=routerfleet

# Database password: choose a long random one. The bundled database is created
# with it on the first start; changing it later means changing it inside
# PostgreSQL too.
POSTGRES_PASSWORD=your_database_password

# Only for an external PostgreSQL server (docker-compose-no-postgres.yml).
# Empty means the bundled database; the port defaults to 5432.
#POSTGRES_HOST=
#POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# The time zone of backup and schedule times, reports and timestamps.
# A name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# on: look for new RouterFleet Improved releases about once an hour (GitHub's
# latest release; nothing about this installation is sent) and show them in
# the top bar. off: make no such request.
UPDATE_CHECK=on

# Django's debug mode. Keep False: True shows internal details on errors to
# anyone who sees an error page. Only for development.
DEBUG_MODE=False

# The application runs as an unprivileged user (routerfleet). Only should
# something need it, APP_USER=root runs it as root, as before 0.38.
#APP_USER=routerfleet
