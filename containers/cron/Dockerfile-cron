# Pinned, not :latest - a floating base tag means two builds of the same commit
# can ship different userlands, and the scheduler is the piece that has to keep
# working untouched for months at a time.
FROM ubuntu:26.04

# cron + curl are all this container needs: it calls the application's /cron/
# endpoints on a schedule and does nothing else.

RUN apt-get update && apt-get install -y cron curl

# The schedule itself
COPY cron_tasks /etc/cron.d/cron_tasks

# cron ignores files in /etc/cron.d that are writable by others
RUN chmod 0644 /etc/cron.d/cron_tasks
# A checkout on Windows brings a carriage return at the end of every line along,
# and cron hands it on to curl as part of the URL - which then answers nothing
# at all. See the note in the Dockerfile of the application.
RUN sed -i 's/\r$//' /etc/cron.d/cron_tasks

# Where the output of every call is appended
RUN touch /var/log/cron.log

# In the foreground, and in exec form, so cron is PID 1 and receives the stop signal directly
CMD ["cron", "-f"]