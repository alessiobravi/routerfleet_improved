# Pinned, not :latest - two builds of the same commit must not ship different
# userlands. The scheduler is the piece that has to keep working untouched for
# months at a time.
FROM alpine:3.24

# cron + curl call the application's /cron/ endpoints on a schedule; their
# replies only go to the log. The updater below is the only other thing here. cronie, not BusyBox's crond,
# because it reads /etc/cron.d with the user column the schedule is written in.
RUN apk upgrade --no-cache \
    && apk add --no-cache cronie curl tzdata jq docker-cli docker-cli-compose

# The updater (rf-update) checks that every image of a release is signed by
# this project's release workflow before using it: cosign, a pinned release,
# checked against its published SHA-256 for each platform
ARG TARGETARCH
ARG COSIGN_VERSION=v3.1.4
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) sum=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa ;; \
      arm64) sum=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2 ;; \
      *) echo "no cosign checksum for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/cosign "https://github.com/sigstore/cosign/releases/download/$COSIGN_VERSION/cosign-linux-$TARGETARCH"; \
    echo "$sum  /usr/local/bin/cosign" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/cosign

# Updates approved in System settings; does nothing unless the compose file
# gives it the Docker socket and the update volumes (docs/updating.md)
COPY rf-update /usr/local/bin/rf-update
RUN sed -i 's/\r$//' /usr/local/bin/rf-update && chmod 0755 /usr/local/bin/rf-update

# The schedule itself
COPY cron_tasks /etc/cron.d/cron_tasks

# cron ignores files in /etc/cron.d that are writable by others
RUN chmod 0644 /etc/cron.d/cron_tasks
# A checkout on Windows brings a carriage return at the end of every line along,
# and cron hands it on to curl as part of the URL - which then answers nothing
# at all. See the note in the Dockerfile of the application.
RUN sed -i 's/\r$//' /etc/cron.d/cron_tasks

# Where the output of every call is appended
RUN touch /var/log/cron.log

# In the foreground, and in exec form, so crond is PID 1 and receives the stop signal directly
CMD ["/usr/sbin/crond", "-n"]
