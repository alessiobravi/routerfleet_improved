FROM python:3.14-alpine
WORKDIR /app

# Every available update at build time; fping does the checks, tzdata lets
# TIMEZONE name a zone for the log timestamps
RUN apk upgrade --no-cache \
    && apk add --no-cache fping tzdata

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall --yes pip
COPY monitoring.py listener.py ./

CMD ["python", "-u", "monitoring.py"]
