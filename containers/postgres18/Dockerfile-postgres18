# The database image: the official postgres:18 on Alpine, with every update
# Alpine has published installed at build time.
#
# New databases are created with PostgreSQL's built-in C.UTF-8 ordering
# (PostgreSQL 17 and later): how text sorts no longer comes from the C
# library, so the image can change base - glibc or musl - without leaving
# indexes ordered the old way. An installation coming from the PostgreSQL 16
# image moves by export and re-import (scripts/migrate-database.sh), never by
# reusing its files.
# gosu is how the official entrypoint drops root. The binary the image ships
# was built with an older Go whose standard library has known vulnerabilities
# (a critical one in crypto/tls), so it is rebuilt from source with the current
# Go and current libraries - cross-compiled, so arm64 does not build under
# emulation.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS gosu
ARG TARGETOS
ARG TARGETARCH
ARG GOSU_VERSION=1.20
ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN apk add --no-cache git
RUN git clone --depth 1 --branch "${GOSU_VERSION}" https://github.com/tianon/gosu.git /src
WORKDIR /src
RUN go get golang.org/x/sys@latest github.com/moby/sys/user@latest \
    && go mod tidy \
    && GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -trimpath -ldflags="-s -w" -o /out/gosu .

FROM postgres:18-alpine
RUN apk upgrade --no-cache
COPY --from=gosu /out/gosu /usr/local/bin/gosu
# The same check the official image runs after installing it
RUN gosu --version && gosu nobody true
ENV POSTGRES_INITDB_ARGS="--encoding=UTF8 --locale-provider=builtin --builtin-locale=C.UTF-8 --locale=C.UTF-8"
# PostgreSQL 16's programs, only to read a database of releases before 0.24
# on the first start and move it (rf-migrate-initdb.sh). Where Alpine installs
# them is found and written down; the build fails if they do not run.
RUN apk add --no-cache postgresql16 \
    && PG16="$(dirname "$(find /usr -path '*postgresql16*' -name postgres -type f | head -1)")" \
    && "$PG16/postgres" --version | grep -q ' 16\.' \
    && "$PG16/pg_ctl" --version \
    && echo "$PG16" > /usr/local/share/rf-pg16-bin
COPY rf-guard.sh /usr/local/bin/rf-guard.sh
COPY rf-migrate-initdb.sh /docker-entrypoint-initdb.d/00-routerfleet-migrate.sh
RUN sed -i 's/\r$//' /usr/local/bin/rf-guard.sh /docker-entrypoint-initdb.d/00-routerfleet-migrate.sh \
    && chmod 0755 /usr/local/bin/rf-guard.sh /docker-entrypoint-initdb.d/00-routerfleet-migrate.sh
ENTRYPOINT ["rf-guard.sh"]
CMD ["postgres"]
